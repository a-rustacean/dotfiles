{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "view": "auto",
    "tree": true,
    "single": false
  },
  "animations": true,
  "theme": {
    "mode": "dark",
    "name": "catppuccin"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "submit_scroll": "bottom",
    "thinking": "hide",
    "verbosity": "low",
    "tps": true,
    "permissions": "autoaccept",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "new_location": "launch"
  },
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "vertical",
    "indicators": "status"
  },
  "prompt": {
    "paste": "full"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
